{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // Plugins use Slack's global React (classic JSX), not a bundled copy.
    "jsx": "react",
    "allowUmdGlobalAccess": true,
    "types": ["node", "react"],
    "skipLibCheck": true
  },
  "include": ["plugins/**/*", "types/**/*", "scripts/**/*", "src/**/*"]
}
